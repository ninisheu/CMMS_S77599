{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "laravel-boost": {
        "type": "local",
        "command": [
          "php",
          "artisan",
          "boost:mcp"
        ]
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--browser",
          "chromium"
        ],
        "environment": {
          "LD_LIBRARY_PATH": "/home/ninish/.local/opt/pw-deps/usr/lib/x86_64-linux-gnu"
        }
      }
    }
  }
}
